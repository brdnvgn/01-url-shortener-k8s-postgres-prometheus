# PostgreSQL connection used by the API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener

# Length of the generated short codes
CODE_LENGTH=6

# asyncpg connection pool size
POOL_MIN_SIZE=1
POOL_MAX_SIZE=10

# Public URL the API is exposed under (e.g. behind a Kubernetes Ingress).
# Leave unset locally; falls back to X-Forwarded-* headers, then the raw request URL.
# PUBLIC_BASE_URL=https://short.example.com
